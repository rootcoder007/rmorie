#!/bin/sh
# rmorie command-line launcher (installed by rmorie::install_cli()).
# Runs morie_cli() from whichever arm of the package is installed. Rscript adds the
# --args separator itself; passing one explicitly makes R 4.6's commandArgs(TRUE) return
# it as the first argument ("unknown verb --args"), so the arguments follow the expression.
exec Rscript --no-save --no-restore -e 'suppressPackageStartupMessages({ p <- if (requireNamespace("rmorie", quietly = TRUE)) "rmorie" else "morie"; q <- getNamespace(p)$morie_cli(); quit(status = as.integer(q)) })' "$@"
