#
# Auto-activate renv when an R session starts in this directory.
# Created by renv::init() (or the Makefile renv-init target). If the
# renv/activate.R script is absent (fresh clone), this is a no-op.
if (file.exists("renv/activate.R")) {
  source("renv/activate.R")
}
